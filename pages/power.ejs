<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS Power</title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%
        const power = data || {};
        const banks = powerBanks || [];
        const batteryState = charge => charge <= 20 ? "danger" : charge <= 45 ? "warn" : "ok";
        const generatorState = watts => Number(watts || 0) > 0 ? "ok" : "warn";
        const bankState = (bank, charge) => !bank.online ? "danger" : charge <= 20 ? "danger" : charge <= 45 ? "warn" : "ok";
        const netWatts = Number(power.net_power_w || 0);
        const totalBankCount = banks.reduce((sum, bank) => sum + Number(bank.count || 0), 0);
        const hasOfflineBank = banks.some(bank => !bank.online);
        const charge = Math.max(0, Math.min(100, Number(power.battery_charge_percent || 0)));
        const batteryCount = totalBankCount || Number(power.battery_count || 0);
        const batteryStatus = totalBankCount > 0 ? hasOfflineBank ? "Partial" : "Online" : batteryCount > 0 ? "Online" : "Offline";
        const batteryPanelState = hasOfflineBank ? "warn" : power.battery_error ? "danger" : batteryState(charge);
        const command = generationCommand || power.generation_command;
    %>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <div class="power-heading">
                <div>
                    <p class="eyebrow">StationOS</p>
                    <h1>Power Control</h1>
                </div>
                <div class="system-pill state-<%= netWatts < 0 ? "danger" : "ok" %> <%= netWatts < 0 ? "danger" : "ok" %>" id="power-state">
                    <%= netWatts >= 0 ? "Grid stable" : "Power deficit" %>
                </div>
            </div>

            <section class="power-layout">
                <article class="panel battery-panel state-<%= batteryPanelState %>" id="battery-panel">
                    <div class="panel-header">Battery Bank</div>
                    <div class="panel-body">
                        <div class="battery-readout">
                            <div>
                                <div class="metric" id="battery-charge"><%= power.battery_charge || "0%" %></div>
                                <div class="label" id="battery-count"><%= batteryCount %> batteries online</div>
                            </div>
                            <div class="battery-icon" aria-hidden="true">
                                <div id="battery-fill" style="height: <%= power.battery_charge || "0%" %>"></div>
                            </div>
                        </div>

                        <div class="power-row">
                            <span>Status</span>
                            <strong id="battery-status"><%= batteryStatus %></strong>
                        </div>
                        <div class="power-row">
                            <span>Error</span>
                            <strong id="battery-error"><%= power.battery_error ? "Error" : "None" %></strong>
                        </div>
                    </div>
                </article>

                <article class="panel state-<%= netWatts < 0 ? "danger" : "ok" %>" id="grid-panel">
                    <div class="panel-header">Grid Load</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Actual Input</span>
                            <strong id="power-in"><%= power.power_actual_in || "0 W" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Consumption</span>
                            <strong id="power-out"><%= power.power_actual_out || "0 W" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Required</span>
                            <strong id="power-required"><%= power.power_required || "0 W" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Net</span>
                            <strong class="<%= netWatts < 0 ? "danger" : "ok" %>" id="power-net"><%= power.net_power || "0 W" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Automation</span>
                            <strong id="generation-command"><%= command ? `${command.target}: ${command.reason}` : "-" %></strong>
                        </div>
                    </div>
                </article>
            </section>

            <h2 class="page-title">Power Banks</h2>
            <section class="device-grid power-bank-grid" id="bank-grid">
                <% if (banks.length) { %>
                    <% banks.forEach((bank) => {
                        const bankChargePercent = Math.max(0, Math.min(100, Number(bank.ratio || 0) * 100));
                        const state = bankState(bank, bankChargePercent);
                    %>
                        <article class="device-card state-<%= state %>">
                            <div class="bank-card-layout">
                                <div class="bank-card-content">
                                    <div class="device-card-top">
                                        <div>
                                            <strong><%= bank.name || bank.id %></strong>
                                            <span><%= bank.id %></span>
                                        </div>
                                        <em class="<%= state %>"><%= bank.online ? "Online" : "Offline" %></em>
                                    </div>
                                    <div class="device-metric"><%= bank.charge || "0%" %></div>
                                    <div class="device-rows">
                                        <div><span>Actual Out</span><strong><%= bank.actual_power_out || "0 W" %></strong></div>
                                        <div><span>Potential In</span><strong><%= bank.potential_power_in || "0 W" %></strong></div>
                                        <div><span>Battery Count</span><strong><%= Number(bank.count || 0) %></strong></div>
                                    </div>
                                </div>
                                <div class="battery-icon bank-battery-icon" aria-hidden="true">
                                    <div style="height: <%= bank.charge || "0%" %>"></div>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <article class="panel">
                        <div class="panel-body">Waiting for battery bank telemetry.</div>
                    </article>
                <% } %>
            </section>

            <h2 class="page-title">Generation</h2>
            <section class="generator-grid">
                <article class="generator-card state-<%= generatorState(power.wind_power_w) %>" id="wind-card">
                    <div class="generator-top">
                        <span>Wind Turbines</span>
                        <strong id="wind-status"><%= Number(power.wind_power_w || 0) > 0 ? "Online" : "Offline" %></strong>
                    </div>
                    <div class="generator-value" id="wind-power"><%= power.windTurbine_power || "0 W" %></div>
                </article>

                <article class="generator-card state-<%= power.gfg_error ? "danger" : generatorState(power.gfg_power_w) %>" id="gfg-card">
                    <div class="generator-top">
                        <span>Gas Fuel Generators</span>
                        <strong id="gfg-count"><%= power.gfg_count || 0 %> units</strong>
                    </div>
                    <div class="generator-value" id="gfg-power"><%= power.gfg_power || "0 W" %></div>
                    <div class="generator-detail">
                        <span>Error</span>
                        <strong id="gfg-error"><%= power.gfg_error ? "Error" : "None" %></strong>
                    </div>
                    <div class="generator-detail">
                        <span>Gas</span>
                        <strong id="gfg-mols"><%= power.gfg_mols_label || "0 mol" %></strong>
                    </div>
                </article>

                <article class="generator-card state-<%= power.sfg_error ? "danger" : generatorState(power.sfg_power_w) %>" id="sfg-card">
                    <div class="generator-top">
                        <span>Solid Fuel Generators</span>
                        <strong id="sfg-count"><%= power.sfg_count || 0 %> units</strong>
                    </div>
                    <div class="generator-value" id="sfg-power"><%= power.sfg_power || "0 W" %></div>
                    <div class="generator-detail">
                        <span>Error</span>
                        <strong id="sfg-error"><%= power.sfg_error ? "Error" : "None" %></strong>
                    </div>
                    <div class="generator-detail">
                        <span>Coal</span>
                        <strong id="sfg-coal"><%= power.sfg_coal_count || 0 %> / <%= power.sfg_coal_capacity || 0 %></strong>
                    </div>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
