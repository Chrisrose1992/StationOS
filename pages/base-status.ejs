<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS Base Status</title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%
        const baseData = base || {};
        const baseFresh = baseData.last_seen && Date.now() - new Date(baseData.last_seen).getTime() < 60000;
        const baseOnline = Boolean(baseData.online) && baseFresh;
    %>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <div class="power-heading">
                <div>
                    <p class="eyebrow">StationOS</p>
                    <h1>Base Status</h1>
                </div>
                <div class="system-pill state-<%= baseOnline ? "ok" : "danger" %>" id="base-online">
                    <%= baseOnline ? "Base online" : "Base offline" %>
                </div>
            </div>

            <section class="grid">
                <article class="panel">
                    <div class="panel-header">Base</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Base ID</span>
                            <strong id="base-id"><%= baseData.base_id || "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>World</span>
                            <strong id="world-name"><%= baseData.world_name || "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Session</span>
                            <strong id="session-id"><%= baseData.session_id || "-" %></strong>
                        </div>
                    </div>
                </article>

                <article class="panel">
                    <div class="panel-header">Heartbeat</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Last Seen</span>
                            <strong id="last-seen"><%= baseData.last_seen ? new Date(baseData.last_seen).toLocaleString() : "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Version</span>
                            <strong id="version"><%= baseData.version || "-" %></strong>
                        </div>
                    </div>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
