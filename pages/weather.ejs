<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS Weather</title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%
        const weatherData = weather || {};
        const weatherMode = Number(weatherData.weather_mode || 0);
        const weatherState = weatherData.weather_error ? "danger" : weatherMode === 2 ? "danger" : weatherMode === 1 ? "warn" : "ok";
        const isNight = weatherData.isNight === "Night Time";
    %>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <div class="power-heading">
                <div>
                    <p class="eyebrow">StationOS</p>
                    <h1>Weather Control</h1>
                </div>
                <div class="system-pill state-<%= weatherState %> <%= weatherState %>" id="weather-state"><%= weatherData.weather_status || "No data" %></div>
            </div>

            <section class="power-layout">
                <article class="panel state-<%= weatherState %>" id="storm-panel">
                    <div class="panel-header">Storm Status</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Status</span>
                            <strong id="weather-status"><%= weatherData.weather_status || "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Mode</span>
                            <strong id="weather-mode"><%= weatherData.weather_mode ?? "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Next Event</span>
                            <strong id="next-event"><%= weatherData.weather_next_event_label || weatherData.weather_next_event || "-" %></strong>
                        </div>
                    </div>
                </article>

                <article class="panel state-<%= isNight ? "warn" : "ok" %>" id="cycle-panel">
                    <div class="panel-header">Day Cycle</div>
                    <div class="panel-body weather-cycle">
                        <div class="weather-orb <%= isNight ? "night" : "" %>" id="weather-orb"></div>
                        <div>
                            <div class="metric" id="day-night"><%= weatherData.isNight || "-" %></div>
                            <div class="label" id="weather-powered"><%= weatherData.weather_powered ? "Powered" : "No power" %></div>
                        </div>
                    </div>
                </article>
            </section>

            <h2 class="page-title">Outdoor Environment</h2>
            <section class="generator-grid">
                <article class="generator-card state-ok" id="temperature-card">
                    <div class="generator-top">
                        <span>Temperature</span>
                        <strong>Celsius</strong>
                    </div>
                    <div class="generator-value" id="temperature"><%= weatherData.outdoor_temperature ?? "-" %> C</div>
                </article>

                <article class="generator-card state-ok" id="pressure-card">
                    <div class="generator-top">
                        <span>Pressure</span>
                        <strong>Outdoor</strong>
                    </div>
                    <div class="generator-value" id="pressure"><%= weatherData.outdoor_pressure || "-" %></div>
                </article>

                <article class="generator-card state-ok" id="horizontal-card">
                    <div class="generator-top">
                        <span>Horizontal</span>
                        <strong>Solar axis</strong>
                    </div>
                    <div class="generator-value" id="horizontal"><%= weatherData.Horizontal ?? "-" %></div>
                </article>

                <article class="generator-card state-ok" id="vertical-card">
                    <div class="generator-top">
                        <span>Vertical</span>
                        <strong>Solar axis</strong>
                    </div>
                    <div class="generator-value" id="vertical"><%= weatherData.Vertical ?? "-" %></div>
                </article>

                <article class="generator-card state-<%= Number(weatherData.solar_radiance || 0) > 0 ? "ok" : "warn" %>" id="solar-radiance-card">
                    <div class="generator-top">
                        <span>Solar Radiance</span>
                        <strong>W/m2</strong>
                    </div>
                    <div class="generator-value" id="solar-radiance"><%= weatherData.solar_radiance ?? "-" %> W/m2</div>
                </article>

                <article class="generator-card state-<%= weatherData.weather_error ? "danger" : "ok" %>" id="weather-error-card">
                    <div class="generator-top">
                        <span>Error</span>
                        <strong>Weather Station</strong>
                    </div>
                    <div class="generator-value" id="weather-error"><%= weatherData.weather_error ? "Error" : "None" %></div>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
