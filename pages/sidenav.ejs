<nav>
    <a data-nav-link class="<%= locals.currentPath === '/' ? 'active' : '' %>" href="/">Overview</a>
    <a data-nav-link class="<%= locals.currentPath === '/base-status' ? 'active' : '' %>" href="/base-status">Base Status</a>
    <a data-nav-link class="<%= locals.currentPath === '/power' ? 'active' : '' %>" href="/power">Power</a>
    <a data-nav-link class="<%= locals.currentPath === '/workshop' ? 'active' : '' %>" href="/workshop">Workshop</a>
    <a data-nav-link class="<%= locals.currentPath === '/weather' ? 'active' : '' %>" href="/weather">Weather</a>

    <details class="nav-accordion" open>
        <summary>Rooms</summary>
        <div class="nav-submenu" id="room-list">
            <% Object.entries(locals.rooms || {}).forEach(([roomId, room]) => {
                const href = roomId === "hallway" ? "/hallway" : `/rooms/${encodeURIComponent(roomId)}`;
            %>
                <a data-nav-link class="<%= locals.currentPath === href ? 'active' : '' %>" href="<%= href %>"><%= room.room || roomId %></a>
            <% }) %>
        </div>
    </details>
</nav>
