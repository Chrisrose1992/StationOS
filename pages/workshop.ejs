<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS Workshop</title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%
        const printerList = printers || [];
        const printerState = printer => !printer.online ? "danger" : printer.active ? "ok" : "warn";
    %>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <div class="power-heading">
                <div>
                    <p class="eyebrow">StationOS</p>
                    <h1>Workshop</h1>
                </div>
                <div class="system-pill" id="printer-count"><%= printerList.length %> printers</div>
            </div>

            <section class="device-grid" id="printer-grid">
                <% if (printerList.length) { %>
                    <% printerList.forEach((printer) => {
                        const state = printerState(printer);
                        const target = Number(printer.print_amount || 0);
                        const printed = Number(printer.printed_count || 0);
                        const percent = target > 0 ? Math.max(0, Math.min(100, (printed / target) * 100)) : 0;
                    %>
                        <article class="device-card state-<%= state %>">
                            <div class="device-card-top">
                                <div>
                                    <strong><%= printer.name || printer.id %></strong>
                                    <span><%= printer.type || "printer" %></span>
                                </div>
                                <em class="<%= state %>"><%= printer.active ? "Printing" : printer.online ? "Idle" : "Offline" %></em>
                            </div>
                            <div class="device-metric"><%= printer.recipe_name || "No recipe" %></div>
                            <div class="battery-meter">
                                <div style="width: <%= percent %>%"></div>
                            </div>
                            <div class="device-rows">
                                <div><span>Progress</span><strong><%= printed %> / <%= target %></strong></div>
                                <div><span>Completion</span><strong><%= (Number(printer.completion || 0) * 100).toFixed(0) %>%</strong></div>
                                <div><span>Recipe Hash</span><strong><%= Number(printer.recipe_hash || 0) %></strong></div>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <article class="panel"><div class="panel-body">Waiting for workshop printer telemetry.</div></article>
                <% } %>
            </section>
        </main>
    </div>
</body>
</html>
