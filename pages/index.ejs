<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS Overview</title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <h1 class="page-title">Overview</h1>

            <section class="grid">
                <article class="panel">
                    <div class="panel-header">Battery</div>
                    <div class="panel-body">
                        <div class="metric" id="battery-charge"><%= station.power_monitor.battery_charge || "0%" %></div>
                        <div class="label" id="battery-count"><%= station.power_monitor.battery_count || 0 %> batteries</div>
                    </div>
                </article>

                <article class="panel">
                    <div class="panel-header">Weather</div>
                    <div class="panel-body">
                        <div class="metric" id="weather-status"><%= station.weather.weather_status || "-" %></div>
                        <div class="label" id="day-night"><%= station.weather.isNight || "Day cycle" %></div>
                    </div>
                </article>

                <article class="panel">
                    <div class="panel-header">Hallway</div>
                    <div class="panel-body">
                        <div class="metric" id="hallway-room"><%= station.hallway.room || "-" %></div>
                        <div class="label" id="hallway-occupied"><%= station.hallway.occupied ? "Occupied" : "Clear" %></div>
                    </div>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
