<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StationOS <%= roomName || 'Room' %></title>
    <link rel="stylesheet" href="/css/stationos.css">
</head>
<body>
    <%
        const roomData = room || {};
        const lightColours = {
            0: { name: "Blue", hex: "#212AA5" },
            1: { name: "Gray", hex: "#7B7B7B" },
            2: { name: "Green", hex: "#3F9B39" },
            3: { name: "Orange", hex: "#FF662B" },
            4: { name: "Red", hex: "#E70200" },
            5: { name: "Yellow", hex: "#FFBC1B" },
            6: { name: "White", hex: "#E7E7E7" },
            7: { name: "Black", hex: "#080908" },
            8: { name: "Brown", hex: "#633C2B" },
            9: { name: "Khaki", hex: "#63633F" },
            10: { name: "Pink", hex: "#E41C99" },
            11: { name: "Purple", hex: "#732CA7" },
        };
        const percentValue = value => Math.max(0, Math.min(100, Number(value || 0)));
        const gasState = (value, dangerAt) => percentValue(value) >= dangerAt ? "danger" : percentValue(value) > 0 ? "warn" : "ok";
        const hazard = roomData.hazard === 1 || roomData.hazard === true;
        const occupied = Number(roomData.occupied || 0) > 0;
        const displayRoomName = roomData.room || roomName || "Room";
        const roomState = hazard ? "danger" : occupied ? "warn" : "ok";
        const roomStateText = hazard ? "Hazard" : occupied ? "Occupied" : "Clear";
        const lightColour = lightColours[Number(roomData.light_colour)] || { name: "Unknown", hex: "#303946" };
        const gases = [
            ["oxygen", "Oxygen", roomData.oxygen, 80],
            ["nitrogen", "Nitrogen", roomData.nitrogen, 90],
            ["methane", "Methane", roomData.methane, 20],
            ["co2", "Carbon Dioxide", roomData.carbonDioxide, 20],
            ["pollution", "Pollution", roomData.pollution, 50],
        ];
    %>
    <%- include('header') %>

    <div class="layout">
        <%- include('sidenav') %>

        <main>
            <div class="power-heading">
                <div>
                    <p class="eyebrow">StationOS</p>
                    <h1 id="room-title"><%= displayRoomName %></h1>
                </div>
                <div class="system-pill state-<%= roomState %> <%= roomState %>" id="room-state"><%= roomStateText %></div>
            </div>

            <section class="power-layout">
                <article class="panel state-<%= roomState %>" id="occupancy-panel">
                    <div class="panel-header">Room Status</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Room</span>
                            <strong id="room"><%= displayRoomName %></strong>
                        </div>
                        <div class="power-row">
                            <span>Occupancy</span>
                            <strong id="occupied"><%= occupied ? "Occupied" : "Clear" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Hazard</span>
                            <strong id="hazard"><%= hazard ? "Hazard detected" : "Clear" %></strong>
                        </div>
                    </div>
                </article>

                <article class="panel state-<%= hazard ? "danger" : "ok" %>" id="environment-panel">
                    <div class="panel-header">Environment</div>
                    <div class="panel-body power-stack">
                        <div class="power-row">
                            <span>Temperature</span>
                            <strong id="temperature"><%= roomData.temperature ?? 0 %> C</strong>
                        </div>
                        <div class="power-row">
                            <span>Pressure</span>
                            <strong id="pressure"><%= roomData.pressure || "-" %></strong>
                        </div>
                        <div class="power-row">
                            <span>Light Colour</span>
                            <strong class="colour-readout">
                                <span class="colour-swatch" id="light-colour-swatch" style="background: <%= lightColour.hex %>"></span>
                                <span id="light-colour"><%= lightColour.name %> (<%= roomData.light_colour ?? "-" %>)</span>
                            </strong>
                        </div>
                    </div>
                </article>
            </section>

            <h2 class="page-title">Atmosphere</h2>
            <section class="atmos-grid">
                <% gases.forEach(([id, label, value, dangerAt]) => {
                    const percent = percentValue(value);
                %>
                    <article class="atmos-card state-<%= gasState(value, dangerAt) %>" id="<%= id %>-card">
                        <div class="atmos-top">
                            <span><%= label %></span>
                            <strong id="<%= id %>-value"><%= percent.toFixed(2) %>%</strong>
                        </div>
                        <div class="atmos-bar"><div id="<%= id %>-bar" style="width: <%= percent %>%"></div></div>
                    </article>
                <% }) %>
            </section>

            <h2 class="page-title">Lighting</h2>
            <section class="generator-grid">
                <article class="generator-card">
                    <div class="generator-top">
                        <span>Long Lights</span>
                        <strong id="long-lights"><%= roomData.long_lights || 0 %> online</strong>
                    </div>
                    <div class="generator-value" id="long-light-value"><%= roomData.long_lights || 0 %></div>
                </article>

                <article class="generator-card">
                    <div class="generator-top">
                        <span>Round Lights</span>
                        <strong id="round-lights"><%= roomData.round_lights || 0 %> online</strong>
                    </div>
                    <div class="generator-value" id="round-light-value"><%= roomData.round_lights || 0 %></div>
                </article>

                <article class="generator-card">
                    <div class="generator-top">
                        <span>LED Lights</span>
                        <strong id="led-lights"><%= roomData.led_lights || 0 %> online</strong>
                    </div>
                    <div class="generator-value" id="led-light-value"><%= roomData.led_lights || 0 %></div>
                </article>

                <article class="generator-card">
                    <div class="generator-top">
                        <span>Total Lights</span>
                        <strong>Room total</strong>
                    </div>
                    <div class="generator-value" id="total-lights"><%= roomData.total_lights || 0 %></div>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
