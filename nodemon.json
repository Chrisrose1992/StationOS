{
  "watch": [
    "server.js",
    "controller/",
    "data_models/",
    "helper/",
    "middleware/",
    "routes/",
    "utils/"
  ],
  "ignore": [
    "node_modules/",
    ".git/",
    ".idea/",
    "logs/",
    "Lua Code/",
    "public/"
  ],
  "ext": "js,json",
  "exec": "node server.js",
  "delay": "1000",
  "env": {
    "NODE_ENV": "development"
  }
}
